<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.xiaolanjing.mapper.CustomerMapper">

    <select id="findByUsername" resultType="Customer">
        SELECT * FROM customer WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="Customer" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer(username, password) VALUES (#{username}, #{password})
    </insert>

</mapper>
